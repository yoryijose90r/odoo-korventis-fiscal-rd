# Copy to .env next to this file. Never commit .env or real passwords.
# Compose reads this file for ${...} interpolation. PostgreSQL is not published.
# Passwords may include @ # / : % ? & because the service uses discrete
# PostgreSQL parameters, not a single DATABASE_URL.

KORVENTIS_DGII_POSTGRES_PASSWORD=change-me-generate-locally
KORVENTIS_DGII_PUBLISH_PORT=8080
KORVENTIS_DGII_LOG_LEVEL=INFO

# Hardcoded false in Compose. Keep these false in .env as documentation only.
KORVENTIS_DGII_AUTO_IMPORT=false
KORVENTIS_DGII_ALLOW_REMOTE=false

# docker-compose.shared.yml requires this variable (no silent Python default of 1).
# Official QA load used 750000. Local compose defaults to 1 only if this line is omitted.
# Fictional fixtures may set 1. Never run an official padrón with 1.
KORVENTIS_DGII_IMPORT_MIN_RECORDS=750000
KORVENTIS_DGII_IMPORT_MAX_REJECT_RATIO=0.001
KORVENTIS_DGII_RESTORE_LOCK_TIMEOUT_MS=5000
