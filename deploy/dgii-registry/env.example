# Copy to .env next to this file. Never commit .env or real passwords.
# Compose reads this file for ${...} interpolation. PostgreSQL is not published.
# Passwords may include @ # / : % ? & because the service uses discrete
# PostgreSQL parameters, not a single DATABASE_URL.

KORVENTIS_DGII_POSTGRES_PASSWORD=change-me-generate-locally
KORVENTIS_DGII_MODE=local
KORVENTIS_DGII_PUBLISH_PORT=8080
KORVENTIS_DGII_LOG_LEVEL=INFO
KORVENTIS_DGII_AUTO_IMPORT=false
