# Variables for scripts/install_korventis.sh, scripts/verify_korventis.sh
# and scripts/enable_dgii_cron.sh
# Copy to a local file outside git. Never commit passwords.

ODOO_BIN=odoo-bin
ODOO_CONF=/etc/odoo/odoo.conf
ODOO_DB=korventis_fiscal_test
KORVENTIS_ACTION=install
KORVENTIS_MODULES=korventis_l10n_do_fiscal,korventis_partner_dgii
KORVENTIS_PROTECTED_DATABASES=korventis baruchcafe
# Only for scripts/enable_dgii_cron.sh after a successful first import:
# KORVENTIS_ENABLE_CRON=yes

