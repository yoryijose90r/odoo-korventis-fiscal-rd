<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiscal_document_list" model="ir.ui.view">
        <field name="name">korventis.fiscal.document.list</field>
        <field name="model">korventis.fiscal.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="fiscal_number"/>
                <field name="document_type_id"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="state"/>
                <field name="amount_total"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_fiscal_document_form" model="ir.ui.view">
        <field name="name">korventis.fiscal.document.form</field>
        <field name="model">korventis.fiscal.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reserved,issued,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="fiscal_number"/>
                            <field name="sequence_number"/>
                            <field name="document_type_id"/>
                            <field name="sequence_id"/>
                            <field name="original_document_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="partner_id"/>
                            <field name="move_id"/>
                            <field name="issue_datetime"/>
                            <field name="currency_id"/>
                            <field name="amount_untaxed"/>
                            <field name="amount_tax"/>
                            <field name="amount_total"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Events">
                            <field name="event_ids" readonly="1">
                                <list>
                                    <field name="event_datetime"/>
                                    <field name="event_type"/>
                                    <field name="user_id"/>
                                    <field name="old_value"/>
                                    <field name="new_value"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fiscal_document" model="ir.actions.act_window">
        <field name="name">Documentos fiscales</field>
        <field name="res_model">korventis.fiscal.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
