<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiscal_sequence_list" model="ir.ui.view">
        <field name="name">korventis.fiscal.sequence.list</field>
        <field name="model">korventis.fiscal.sequence</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="document_type_id"/>
                <field name="prefix"/>
                <field name="range_start"/>
                <field name="range_end"/>
                <field name="next_number"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_fiscal_sequence_form" model="ir.ui.view">
        <field name="name">korventis.fiscal.sequence.form</field>
        <field name="model">korventis.fiscal.sequence</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="document_type_id"/>
                            <field name="prefix"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="range_start"/>
                            <field name="range_end"/>
                            <field name="next_number"/>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fiscal_sequence" model="ir.actions.act_window">
        <field name="name">Secuencias / Rangos</field>
        <field name="res_model">korventis.fiscal.sequence</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
