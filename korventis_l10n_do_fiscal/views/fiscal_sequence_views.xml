<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiscal_sequence_list" model="ir.ui.view">
        <field name="name">korventis.fiscal.sequence.list</field>
        <field name="model">korventis.fiscal.sequence</field>
        <field name="arch" type="xml">
            <list decoration-warning="operational_state == 'warning'"
                  decoration-danger="operational_state == 'expired'"
                  decoration-muted="operational_state == 'exhausted'">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="document_type_id"/>
                <field name="prefix"/>
                <field name="range_start"/>
                <field name="range_end"/>
                <field name="next_number"/>
                <field name="total_numbers"/>
                <field name="used_numbers"/>
                <field name="remaining_numbers"/>
                <field name="used_percent"/>
                <field name="remaining_percent"/>
                <field name="warning_threshold_percent"/>
                <field name="operational_state"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_fiscal_sequence_form" model="ir.ui.view">
        <field name="name">korventis.fiscal.sequence.form</field>
        <field name="model">korventis.fiscal.sequence</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-warning"
                         role="alert"
                         invisible="operational_state != 'warning'">
                        <strong>Esta secuencia fiscal está próxima a agotarse.</strong>
                        Quedan
                        <field name="remaining_numbers" readonly="1" class="oe_inline"/>
                        de
                        <field name="total_numbers" readonly="1" class="oe_inline"/>
                        comprobantes disponibles. Considere gestionar una nueva secuencia ante DGII.
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="document_type_id"/>
                            <field name="prefix"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="range_start"/>
                            <field name="range_end"/>
                            <field name="next_number"/>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                        </group>
                    </group>
                    <group string="Consumo y alerta preventiva">
                        <group>
                            <field name="total_numbers" readonly="1"/>
                            <field name="used_numbers" readonly="1"/>
                            <field name="remaining_numbers" readonly="1"/>
                        </group>
                        <group>
                            <field name="used_percent" readonly="1"/>
                            <field name="remaining_percent" readonly="1"/>
                            <field name="warning_threshold_percent"/>
                            <field name="operational_state" readonly="1"/>
                            <field name="warning_triggered" readonly="1"/>
                            <field name="warning_triggered_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_fiscal_sequence" model="ir.actions.act_window">
        <field name="name">Secuencias / Rangos</field>
        <field name="res_model">korventis.fiscal.sequence</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
