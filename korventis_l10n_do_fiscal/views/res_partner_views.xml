<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_korventis_fiscal" model="ir.ui.view">
        <field name="name">res.partner.form.korventis.fiscal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="korventis_fiscal_document_type_id"
                       placeholder="E32 Consumidor Final / E31 crédito fiscal"/>
            </xpath>
        </field>
    </record>
</odoo>
