<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_import_dgii_registry" model="ir.cron">
        <field name="name">Korventis: actualizar padrón DGII</field>
        <field name="model_id" ref="model_korventis_dgii_import_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_import_registry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall"
               eval="(datetime.utcnow() + relativedelta(days=365)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="priority">10</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
