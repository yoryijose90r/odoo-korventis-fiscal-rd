<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_korventis_partner_lookup" model="ir.ui.view">
        <field name="name">account.move.form.korventis.partner.lookup</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='partner_id'][@widget='res_partner_many2one']"
                   position="after">
                <button name="action_korventis_lookup_partner"
                        type="object"
                        string="Buscar cliente DGII"
                        class="btn-link"
                        groups="korventis_partner_dgii.group_dgii_user,account.group_account_invoice"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
