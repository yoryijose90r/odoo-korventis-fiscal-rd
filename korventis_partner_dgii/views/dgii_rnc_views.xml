<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dgii_rnc_search" model="ir.ui.view">
        <field name="name">korventis.dgii.rnc.search</field>
        <field name="model">korventis.dgii.rnc</field>
        <field name="arch" type="xml">
            <search string="Buscar en padrón DGII">
                <field name="rnc"/>
                <field name="razon_social"/>
                <field name="estado"/>
                <filter name="active_status" string="ACTIVO"
                        domain="[('estado', '=', 'ACTIVO')]"/>
                <filter name="suspended_status" string="SUSPENDIDO"
                        domain="[('estado', '=', 'SUSPENDIDO')]"/>
            </search>
        </field>
    </record>

    <record id="view_dgii_rnc_list" model="ir.ui.view">
        <field name="name">korventis.dgii.rnc.list</field>
        <field name="model">korventis.dgii.rnc</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-warning="estado == 'SUSPENDIDO'"
                  decoration-muted="estado in ('DADO DE BAJA', 'ANULADO', 'RECHAZADO')">
                <field name="rnc"/>
                <field name="razon_social"/>
                <field name="estado"/>
                <field name="actividad_economica" optional="show"/>
                <field name="fecha_inicio_operaciones" optional="hide"/>
                <field name="regimen_pago" optional="hide"/>
                <field name="version_padron_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dgii_rnc_form" model="ir.ui.view">
        <field name="name">korventis.dgii.rnc.form</field>
        <field name="model">korventis.dgii.rnc</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="estado != 'SUSPENDIDO'">
                        Este contribuyente figura como SUSPENDIDO en la versión consultada.
                        Esta información no constituye autorización fiscal.
                    </div>
                    <group>
                        <group>
                            <field name="rnc"/>
                            <field name="razon_social"/>
                            <field name="estado"/>
                        </group>
                        <group>
                            <field name="actividad_economica"/>
                            <field name="fecha_inicio_operaciones"/>
                            <field name="regimen_pago"/>
                        </group>
                    </group>
                    <group string="Trazabilidad">
                        <field name="version_padron_id"/>
                        <field name="fecha_importacion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dgii_rnc" model="ir.actions.act_window">
        <field name="name">Padrón DGII activo</field>
        <field name="res_model">korventis.dgii.rnc</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('version_padron_id.state', '=', 'active')]</field>
        <field name="search_view_id" ref="view_dgii_rnc_search"/>
    </record>
</odoo>
